rules_version = '2';

// Kanakku security rules. Tested in scripts/test-rules.ts (run in CI against the Firestore emulator).
// Data:
//   users/{uid}                          nickname, createdAt, weeks { "2026-W42": points }
//   progress/{uid}                       lessons, lastLesson, updatedAt
//   weeklyPoints/{weekId}/entries/{uid}  nickname, solved, quizCorrect, points, solvedIds, quizBest, updatedAt
// Nobody can list users or read anyone else's progress. The leaderboard shows nickname and points only.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    function validNickname(n) {
      return n is string && n.size() >= 2 && n.size() <= 16 && n.matches('^[A-Za-z0-9_]+$');
    }

    // ---------- profile ----------
    match /users/{uid} {
      allow get: if isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['nickname', 'createdAt', 'weeks'])
        && validNickname(request.resource.data.nickname)
        && request.resource.data.createdAt == request.time
        && request.resource.data.weeks is map;
      allow update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['nickname', 'createdAt', 'weeks'])
        && validNickname(request.resource.data.nickname)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.weeks is map
        && request.resource.data.weeks.size() <= 600;
      allow delete: if isOwner(uid);
    }

    // ---------- lesson progress ----------
    match /progress/{uid} {
      allow get, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['lessons', 'lastLesson', 'updatedAt'])
        && request.resource.data.lessons is map
        && request.resource.data.lessons.size() <= 200
        && (!('lastLesson' in request.resource.data) || request.resource.data.lastLesson is map)
        && request.resource.data.updatedAt == request.time;
    }

    // ---------- weekly leaderboard ----------
    match /weeklyPoints/{weekId}/entries/{uid} {
      // Any signed-in student can read the board (nickname and points only are stored here).
      allow read: if signedIn() && weekId.matches('^[0-9]{4}-W[0-9]{2}$');

      // Points can only be earned one event at a time: one new practice question, or one quiz.
      allow create: if isOwner(uid) && validEntry()
        && weekId.matches('^[0-9]{4}-W[0-9]{2}$')
        && request.resource.data.solved <= 1
        && request.resource.data.quizCorrect <= 10;
      allow update: if isOwner(uid) && validEntry()
        && request.resource.data.solved - resource.data.solved >= 0
        && request.resource.data.solved - resource.data.solved <= 1
        && request.resource.data.quizCorrect - resource.data.quizCorrect >= 0
        && request.resource.data.quizCorrect - resource.data.quizCorrect <= 10
        && request.resource.data.solvedIds.keys().hasAll(resource.data.solvedIds.keys());
      allow delete: if false;
    }

    function validEntry() {
      let d = request.resource.data;
      return d.keys().hasOnly(['nickname', 'solved', 'quizCorrect', 'points', 'solvedIds', 'quizBest', 'updatedAt'])
        && validNickname(d.nickname)
        && d.solved is int && d.solved >= 0 && d.solved <= 500
        && d.quizCorrect is int && d.quizCorrect >= 0 && d.quizCorrect <= 500
        && d.solvedIds is map && d.solvedIds.size() == d.solved
        && d.quizBest is map && d.quizBest.size() <= 60
        && d.quizCorrect <= d.quizBest.size() * 10
        && d.points == d.solved * 10 + d.quizCorrect * 5
        && d.updatedAt == request.time;
    }
  }
}
