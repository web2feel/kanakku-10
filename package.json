{
  "name": "kanakku-10",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:single": "tsc -b && vite build --mode single",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "check:content": "tsx scripts/check-content.ts",
    "netlify:login": "netlify login",
    "netlify:link": "netlify link",
    "netlify:init": "netlify init",
    "dev:netlify": "netlify dev",
    "deploy:preview": "npm run check:content && netlify deploy",
    "deploy:prod": "npm run check:content && netlify deploy --prod",
    "format": "prettier --write src scripts",
    "test:accounts": "tsx scripts/test-accounts.ts",
    "dev:mock": "VITE_ACCOUNTS=mock vite",
    "test:rules": "firebase emulators:exec --only firestore --project demo-kanakku \"tsx scripts/test-rules.ts\"",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes",
    "firebase:login": "firebase login"
  },
  "dependencies": {
    "firebase": "^13.0.0",
    "framer-motion": "^14.2.0",
    "katex": "^0.19.0",
    "mafs": "^0.21.0",
    "mathjs": "^15.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/katex": "^0.16.8",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "firebase-tools": "^15.34.0",
    "netlify-cli": "^27.12.1",
    "oxlint": "^1.81.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "engines": {
    "node": ">=20"
  }
}
